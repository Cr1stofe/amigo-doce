# Copy to .env on the server and replace every example value.
POSTGRES_DB=amigo_doce
POSTGRES_USER=amigo_doce
POSTGRES_PASSWORD=replace-with-a-long-random-password

# URL-encode special characters in the PostgreSQL password.
DATABASE_URL=postgresql://amigo_doce:replace-with-a-long-random-password@db:5432/amigo_doce?schema=public

ADMIN_USERNAME=replace-with-an-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Name of the existing external reverse-proxy network.
WEB_GATEWAY_NETWORK=web_gateway
